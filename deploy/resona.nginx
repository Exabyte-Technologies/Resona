server {
    listen 80;
    listen [::]:80;
    server_name resona.neuorise.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://resona.neuorise.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name resona.neuorise.com;

    ssl_certificate /etc/letsencrypt/live/resona.neuorise.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/resona.neuorise.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:ResonaTLS:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    client_max_body_size 8m;

    location / {
        proxy_pass http://unix:/run/resona/resona.sock;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 7200s;
        proxy_send_timeout 7200s;
    }
}
